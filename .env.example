# PostgreSQL
POSTGRES_USER=carfleet
POSTGRES_PASSWORD=change-me
POSTGRES_DB=carfleet

# App
DATABASE_URL=postgresql+psycopg://carfleet:change-me@localhost:5432/carfleet
APP_NAME=Car Fleet Manager
# Povolené originy frontendu, oddelené čiarkou (nikdy *)
CORS_ORIGINS=http://localhost:5173

# Auth
# Tajný kľúč na podpisovanie JWT tokenov (aspoň 32 znakov). Vygeneruj vlastný:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Ako dlho platí prihlásenie (token), v minútach
ACCESS_TOKEN_EXPIRE_MINUTES=30
